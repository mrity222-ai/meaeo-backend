# Application Settings
APP_ENV=production
DEFAULT_BRAND=brand_001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM & AI Models
HF_TOKEN=your_huggingface_token_here
TEXT_MODEL_PROVIDER=gemini
TEXT_MODEL_ALIAS=gemini-3.8-flash
IMAGE_MODEL_PROVIDER=huggingface
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_OUTPUT_DIR=generated/images
TEMPERATURE=0.8
MAX_TOKENS=4096
LLM_MAX_RETRIES=3
IMAGE_MODE=production

# Research & External APIs
TAVILY_API_KEY=your_tavily_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# Database
DATABASE_URL=sqlite:///app.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_TIMEOUT=30
STORAGE_BACKEND=database

# Publishing Configuration
PUBLISH_PROVIDER=facebook
PUBLISH_MODE=production
PUBLISH_TIMEZONE=UTC

# Security & Encryption
CREDENTIAL_ENCRYPTION_KEY=your_credential_encryption_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Meta / Facebook OAuth
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=https://your-domain.com/api/v1/oauth/callback/meta
META_API_VERSION=v26.0
META_CONFIG_ID=your_meta_config_id_here

# Google OAuth & Business
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback
GOOGLE_BUSINESS_REDIRECT_URI=https://your-domain.com/oauth/google-business/callback

# LinkedIn OAuth & API
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=https://your-domain.com/oauth/linkedin/callback

# Assets & Storage
ASSET_STORAGE_BACKEND=local
ASSET_STORAGE_ROOT=data/assets
ASSET_PUBLIC_BASE_URL=https://your-domain.com
ASSET_URL_TTL_SECONDS=3600
ASSET_SIGNING_SECRET=your_asset_signing_secret_here

# Frontend Next.js Public Environment Variables
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_META_REDIRECT_URI=https://your-domain.com/oauth/meta/callback
NEXT_PUBLIC_GOOGLE_BUSINESS_REDIRECT_URI=https://your-domain.com/oauth/google_business/callback
NEXT_PUBLIC_LINKEDIN_REDIRECT_URI=https://your-domain.com/oauth/linkedin/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
EMAIL_FROM_NAME=Autonomous Marketing System
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@avedatechnologies.com
EMAIL_FROM=info@avedatechnologies.com
GEMINI_API_KEY=your_gemini_api_key_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_USE_TLS=True
RESEND_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STABILITY_API_KEY=
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
SUPER_ADMIN_EMAIL=admin@marketingsystem.com
