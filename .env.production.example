# Application Settings
APP_ENV=production
DEFAULT_BRAND=brand_001
CORS_ALLOWED_ORIGINS=https://maeaco.com,https://app.maeaco.com,https://www.maeaco.com

# Database (Auto-configured by deploy_vps.sh or set manually)
DATABASE_URL=postgresql://maeaco_admin:CHANGE_THIS_PASSWORD@localhost:5432/maeaco_prod_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_TIMEOUT=30
STORAGE_BACKEND=database

# LLM & AI Models
HF_TOKEN=your_huggingface_token_here
TEXT_MODEL_PROVIDER=gemini
TEXT_MODEL_ALIAS=gemini-3.8-flash
IMAGE_MODEL_PROVIDER=huggingface
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_OUTPUT_DIR=generated/images
TEMPERATURE=0.8
MAX_TOKENS=4096
LLM_MAX_RETRIES=3
IMAGE_MODE=production

# Research & External APIs
TAVILY_API_KEY=your_tavily_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# Publishing Configuration
PUBLISH_PROVIDER=facebook
PUBLISH_MODE=production
PUBLISH_TIMEZONE=UTC

# Security & Encryption
CREDENTIAL_ENCRYPTION_KEY=generate_random_base64_encryption_key_32_bytes
JWT_SECRET_KEY=generate_random_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Meta / Facebook OAuth (Production HTTPS Redirect URIs)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=https://api.maeaco.com/api/v1/oauth/callback/meta
META_API_VERSION=v26.0
META_CONFIG_ID=your_meta_config_id_here

# Google OAuth & Business
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://api.maeaco.com/auth/google/callback
GOOGLE_BUSINESS_REDIRECT_URI=https://api.maeaco.com/oauth/google-business/callback

# Assets & Storage
ASSET_STORAGE_BACKEND=local
ASSET_STORAGE_ROOT=data/assets
ASSET_PUBLIC_BASE_URL=https://api.maeaco.com
ASSET_URL_TTL_SECONDS=86400
ASSET_SIGNING_SECRET=your_asset_signing_secret_here

# Email Provider
EMAIL_FROM_NAME=maeaco Autonomous Marketing
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=465
SMTP_USER=info@yourdomain.com
EMAIL_FROM=info@yourdomain.com
GEMINI_API_KEY=your_gemini_api_key_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_USE_TLS=True

# Payment Gateway (Razorpay Live Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
SUPER_ADMIN_EMAIL=admin@yourdomain.com
