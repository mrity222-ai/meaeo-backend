# Environment & Secrets Protection (GitHub Push Protection Compliance)
.env
.env.local
.env.production
*.env

# Production Database Preservation (Protects live user data from git pull overwrite)
*.db
*.sqlite
app.db

# Virtual Environments
venv/
.venv/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node.js & Next.js Build Artifacts
node_modules/
.next/
.next-marketing-verify/
out/
build/
dist/

# Logs & System Temp
*.log
.DS_Store
Thumbs.db

# Temp Scratch Testing Outputs
scratch/

# OAuth credentials and encrypted backups
data/credentials/
data/credential-backups/

# Encrypted runtime settings and lock files
data/settings/

# Local backup before the business profile schema update
*.before-business-profile-edit.bak

# Customer/runtime data must remain on the server, not in release commits.
data/assets/
data/analytics/
generated/
backups/
