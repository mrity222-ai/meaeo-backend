FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY autonomous-marketing-frontend-main/package*.json ./

# Install dependencies
RUN npm ci

# Copy frontend source code
COPY autonomous-marketing-frontend-main/ ./

# Pass build environment variables
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_META_REDIRECT_URI

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_META_REDIRECT_URI=$NEXT_PUBLIC_META_REDIRECT_URI

# Build Next.js application
RUN npm run build

# Runner stage
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

CMD ["npm", "start"]
